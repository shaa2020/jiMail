{
  "name": "jimail",
  "private": true,
  "version": "1.0.0",
  "description": "JiMail — self-hosted, multi-tenant email hosting platform built on Stalwart Mail Server",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "pnpm --filter @jimail/api dev",
    "dev:web": "pnpm --filter @jimail/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @jimail/web test:e2e"
  }
}

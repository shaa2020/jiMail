# ───────────────────────── JiMail configuration ─────────────────────────
# Copy to .env (./scripts/jimail init does this and generates the secrets).
# Never commit .env. All values below are placeholders.

# Public hostnames (DNS A/AAAA records must point at this server)
# JiMail web app and API
APP_DOMAIN=app.example.com
# MX target, IMAP/SMTP host, needs matching reverse DNS (PTR)
MAIL_HOSTNAME=mail.example.com
# Server public IPv4, used for PTR/SPF readiness checks
MAIL_PUBLIC_IP=
# Let's Encrypt account e-mail
ACME_EMAIL=ops@example.com
APP_NAME=JiMail
# false = organisations are created by platform admins only
ALLOW_SIGNUP=true

# Generated secrets (./scripts/jimail init)
POSTGRES_PASSWORD=
STALWART_DB_PASSWORD=
REDIS_PASSWORD=
# ≥32 chars, keys token hashes
APP_SECRET=
# 32 bytes base64, encrypts TOTP secrets + mailbox service keys
APP_ENCRYPTION_KEY=
# HMAC key for mail-server delivery events
STALWART_WEBHOOK_SECRET=
# encrypts backups — keep a copy OFF this server
BACKUP_PASSPHRASE=
BACKUP_RETENTION=14

# Written by ./scripts/jimail setup-mail
STALWART_API_KEY=
# temporary, emptied automatically after setup
STALWART_RECOVERY_ADMIN=

# System e-mail (verification, password reset, invitations).
# After setup-mail you can create a mailbox such as no-reply@<your platform domain> and use it here.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JiMail <no-reply@example.com>"

# Billing (optional). Without a provider, plans are managed manually by platform admins.
# none | stripe
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operations
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Slack-compatible incoming webhook for critical alerts
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
STALWART_VERSION=v1
JIMAIL_VERSION=latest

{
	email {$ACME_EMAIL}
	# Certificates for customer autoconfig/MTA-STS hostnames are issued on demand,
	# only for domains JiMail has verified (checked by the API).
	on_demand_tls {
		ask http://api:4000/api/v1/internal/tls-allowed
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# JiMail application (web + API)
{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	@internal path /api/v1/internal/*
	respond @internal 404
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Mail server hostname: JMAP, CalDAV/CardDAV, autodiscovery. Stalwart obtains its own
# certificate for SMTP/IMAP via ACME HTTP-01, forwarded on port 80 below.
{$MAIL_HOSTNAME} {
	import security_headers
	@admin path /admin* /api/*
	respond @admin 404
	reverse_proxy stalwart:8080 {
		header_up X-Forwarded-Proto https
	}
}

http://{$MAIL_HOSTNAME} {
	handle /.well-known/acme-challenge/* {
		reverse_proxy stalwart:8080
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# Customer autoconfiguration hostnames (CNAMEs to the mail hostname).
https:// {
	tls {
		on_demand
	}
	@autocfg host autoconfig.* autodiscover.* mta-sts.* ua-auto-config.*
	handle @autocfg {
		reverse_proxy stalwart:8080
	}
	handle {
		respond 404
	}
}

# Local development (API outside Docker). See docs/DEVELOPMENT.md.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://jimail:jimail_dev@127.0.0.1:5432/jimail
REDIS_URL=redis://127.0.0.1:6379
APP_ENCRYPTION_KEY=          # openssl rand -base64 32
APP_SECRET=                  # openssl rand -hex 32
COOKIE_SECURE=false
STALWART_URL=http://127.0.0.1:18080
STALWART_API_KEY=
STALWART_WEBHOOK_SECRET=
STALWART_WEBHOOK_TARGET=http://172.17.0.1:4000/api/v1/stalwart/webhook
MAIL_HOSTNAME=mail.jimail.test
MAIL_TRANSPORT=file          # development only: writes system mail to MAIL_FILE_DIR
MAIL_FILE_DIR=/tmp/jimail-outbox
DNS_RESOLVERS=127.0.0.1:5353 # fake DNS for tests (apps/api/test/support/fake-dns.js)

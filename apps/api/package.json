{
  "name": "@jimail/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:integration": "jest --runInBand test/integration",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "node dist/cli/seed.js",
    "cli": "node dist/cli/index.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "bullmq": "6.7.10",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "papaparse": "5.7.1",
    "pino": "10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "22.20.7",
    "@types/nodemailer": "^7.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "dns2": "3.1.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
